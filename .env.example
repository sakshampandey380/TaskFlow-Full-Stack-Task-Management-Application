# TaskFlow Application Configuration

# Application
PROJECT_NAME="TaskFlow"
VERSION="1.0.0"
API_V1_PREFIX="/api"
ENVIRONMENT="development"

# Database Configuration (MySQL / MariaDB via XAMPP)
DATABASE_URL="mysql+pymysql://root:@localhost:3306/todo-application?charset=utf8mb4"

# Security & JWT Authentication
# Run `python -c "import secrets; print(secrets.token_hex(32))"` to generate a secure secret
SECRET_KEY="taskflow_super_secret_production_key_change_in_real_deployment_64char"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS='["http://localhost","http://127.0.0.1","http://localhost:8000","http://127.0.0.1:8000","http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500"]'
